APP_NAME=Wellms
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=warning
APP_URL=https://api.andreasschmidt.ch
FRONTEND_URL=https://lms.andreasschmidt.ch

# MariaDB from the Infomaniak Manager (Datenbanken). Fill these in.
DB_CONNECTION=mysql
DB_HOST=<account>.myd.infomaniak.com
DB_PORT=3306
DB_DATABASE=<account>_<name>
DB_USERNAME=<account>_<user>
DB_PASSWORD=

# Shared hosting has no Redis or worker; jobs run immediately (sync). Scheduler runs via cron.php.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
QUEUE_DRIVER=sync

# Mail is set up later (Infomaniak SMTP or Brevo, see MIN-281/MIN-289). Until then mails go to the log.
MAIL_MAILER=log
MAIL_DRIVER=log

# Left empty on purpose: .env.example points to the EscolaLMS developers' Sentry server.
SENTRY_DSN=

TRACKER_ENABLED=false
REPORTBRO_URL="https://www.reportbro.com/report/run"
# MJML: no local mjml service on shared hosting. Configure the MJML API (MJML_API_ID, MJML_API_SECRET) later.

FILESYSTEM_DRIVER=local
SCORM_DISK=local
H5P_AGGREGATE_ASSETS=true
# Public base URL for stored files (local disk via public/storage). H5P reads it as AWS_URL.
AWS_URL=https://api.andreasschmidt.ch/storage
